#.gitignore

# byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# virtual env
venv/
env/
.venv/

# Terraform
.terraform/
**/.terraform/
*.tfstate
*.tfstate.*
crash.log

# Local variable overrides
terraform.tfvars
*.tfvars

# Ignore provider binaries inside modules
modules/**/.terraform/


# packages
dist/
build/
*.egg-info/